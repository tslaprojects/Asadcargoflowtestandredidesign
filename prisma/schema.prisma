// CargoFlow — Prisma schema
// Все даты хранятся в UTC (timestamptz). Денежные суммы — Decimal(14,2).
// Частичные уникальные индексы (активная ставка, принятая ставка, активная подпись)
// создаются вручную в миграции, т.к. Prisma их не выражает.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

