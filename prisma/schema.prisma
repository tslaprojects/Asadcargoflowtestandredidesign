  EXPIRED
  SUSPENDED
  LOST
  CANCELLED
}

enum FuelTransactionStatus {
  PENDING
  AUTHORIZED
  APPROVED
  COMPLETED
  DECLINED
  REVERSED
  REFUNDED
  DISPUTED
}

/// Откуда пришла транзакция: провайдер топливных карт, ручной ввод, приложение водителя, демо-симуляция
enum FuelTransactionSource {
  PROVIDER
  MANUAL
  DRIVER_APP
  DEMO
}

/// Результат сопоставления заправки с GPS и уровнем топлива
enum FuelMatchStatus {
  PENDING
  MATCHED
  PARTIALLY_VERIFIED
  UNVERIFIED
  MISMATCH
}

/// Источник уровня топлива — разные источники не смешиваются
enum FuelLevelSource {
  CAN_J1939
  FUEL_SENSOR
}

enum TelemetrySource {
  TELEMATICS
  FUEL_SENSOR
  GPS_TRACKER
  DRIVER_APP
  MANUAL
  DEMO
}

enum FuelAccountEntryType {
  TOP_UP
  RESERVE
  RELEASE
  CHARGE
  REFUND
  ADJUSTMENT
}

enum FuelAnomalyType {
  LOCATION_MISMATCH
  FUEL_LEVEL_MISMATCH
  TANK_CAPACITY_EXCEEDED
  UNEXPECTED_FUEL_DROP
  FREQUENT_REFUELING
  ROUTE_DEVIATION
}

enum FuelAnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FuelAnomalyStatus {
  OPEN
  CONFIRMED
  DISMISSED
  INVESTIGATING
  RESOLVED
}

enum FuelInvestigationStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)
  locale       String       @default("ru-RU")
  timezone     String       @default("Asia/Almaty")
  lastLoginAt  DateTime?    @db.Timestamptz(3)
  blockedAt    DateTime?    @db.Timestamptz(3)
  blockReason  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?    @db.Timestamptz(3)

  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  memberships                  CompanyMember[]
  driverProfiles               DriverProfile[]
  createdLoads                 Load[]                        @relation("LoadCreatedBy")
  bids                         Bid[]                         @relation("BidCreatedBy")
  bidMessages                  BidMessage[]
  notifications                Notification[]
  signatures                   ContractSignature[]
  chatMessages                 ChatMessage[]
  auditLogs                    AuditLog[]
  idempotencyKeys              IdempotencyKey[]
  chatReadStates               ChatReadState[]
  uploadedCompanyDocuments     CompanyDocument[]             @relation("CompanyDocumentUploader")
  submittedVerifications       VerificationRequest[]         @relation("VerificationSubmitter")
  reviewedVerifications        VerificationRequest[]         @relation("VerificationReviewer")
  uploadedLoadDocuments        LoadDocument[]                @relation("LoadDocumentUploader")
  askedQuestions               LoadQuestion[]                @relation("LoadQuestionAuthor")
  answeredQuestions            LoadQuestion[]                @relation("LoadQuestionAnswerer")
  decidedBids                  Bid[]                         @relation("BidDecidedBy")
  orderStatusChanges           TransportOrderStatusHistory[] @relation("OrderStatusActor")
  orderParticipations          TransportOrderParticipant[]   @relation("OrderParticipantUser")
  uploadedOrderDocuments       OrderDocument[]               @relation("OrderDocumentUploader")
  deletedOrderDocuments        OrderDocument[]               @relation("OrderDocumentDeleter")
  trackingEvents               TrackingEvent[]               @relation("TrackingEventUser")
  createdPayments              PaymentRecord[]               @relation("PaymentCreator")
  requestedPaymentOperations   PaymentTransaction[]          @relation("PaymentOperationRequester")
  paymentStatusChanges         PaymentStatusHistory[]        @relation("PaymentStatusActor")
  plannedMovements             PlannedMovement[]             @relation("PlannedMovementCreator")
  reviewsWritten               Review[]                      @relation("ReviewAuthor")
  openedDisputes               Dispute[]                     @relation("DisputeOpener")
  resolvedDisputes             Dispute[]                     @relation("DisputeResolver")
  disputeComments              DisputeComment[]              @relation("DisputeCommentAuthor")
  sentInvites                  CompanyInvite[]               @relation("InviteSender")
  acceptedInvites              CompanyInvite[]               @relation("InviteAcceptor")
  fuelAccountEntries           FuelAccountEntry[]            @relation("FuelEntryCreator")
  issuedFuelCards              FuelCard[]                    @relation("FuelCardCreator")
  reviewedFuelAnomalies        FuelAnomaly[]                 @relation("FuelAnomalyReviewer")
  openedFuelInvestigations     FuelInvestigation[]           @relation("FuelInvestigationOpener")
  closedFuelInvestigations     FuelInvestigation[]           @relation("FuelInvestigationCloser")
  fuelInvestigationComments    FuelInvestigationComment[]    @relation("FuelInvestigationCommentAuthor")
  fuelInvestigationAttachments FuelInvestigationAttachment[] @relation("FuelInvestigationAttachmentUploader")
}

/// Режим данных сессии: с какой базой работают бизнес-данные (identity — общая, в реальной базе).
enum DataMode {
  REAL
  DEMO
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique
  userId          String    @db.Uuid
  /// Задаётся сервером при входе/переключении; клиент не может изменить режим запросом.
  dataMode        DataMode  @default(REAL)
  activeCompanyId String?   @db.Uuid
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime  @db.Timestamptz(3)
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Companies ─────────────────────────────

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  type               CompanyType
  legalName          String
  tradeName          String?
  registrationNumber String
  taxId              String?
  country            String // ISO 3166-1 alpha-2
  region             String?
  city               String
  address            String
  postalCode         String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  description        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  suspendedAt        DateTime?          @db.Timestamptz(3)
  suspendReason      String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)

  members              CompanyMember[]
  invites              CompanyInvite[]
  documents            CompanyDocument[]
  verificationRequests VerificationRequest[]
  vehicles             Vehicle[]
  drivers              DriverProfile[]
  loads                Load[]
  loadInvitations      LoadInvitation[]
  loadQuestions        LoadQuestion[]
  bids                 Bid[]
  bidMessages          BidMessage[]
  shipperOrders        TransportOrder[]            @relation("OrderShipper")
  carrierOrders        TransportOrder[]            @relation("OrderCarrier")
  forwarderOrders      TransportOrder[]            @relation("OrderForwarder")
  participants         TransportOrderParticipant[]
  signatures           ContractSignature[]
  paymentsOut          PaymentRecord[]             @relation("PaymentPayer")
  paymentsIn           PaymentRecord[]             @relation("PaymentPayee")
  plannedMovements     PlannedMovement[]
  fuelAccounts         FuelAccount[]
  fuelCards            FuelCard[]
  fuelTransactions     FuelTransaction[]
  fuelAnomalies        FuelAnomaly[]
  fuelInvestigations   FuelInvestigation[]
  reviewsGiven         Review[]                    @relation("ReviewFrom")
  reviewsReceived      Review[]                    @relation("ReviewTo")
  auditLogs            AuditLog[]

  uploadedOrderDocuments OrderDocument[] @relation("OrderDocumentCompany")
  chatMessages           ChatMessage[]   @relation("ChatMessageCompany")
  openedDisputes         Dispute[]       @relation("DisputeOpenerCompany")

  @@unique([country, registrationNumber])
  @@index([type])
  @@index([verificationStatus])
  @@index([legalName])
}

model CompanyMember {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  userId    String       @db.Uuid
  role      MemberRole
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model CompanyInvite {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  email            String
  role             MemberRole
  tokenHash        String       @unique
  invitedByUserId  String       @db.Uuid
  status           InviteStatus @default(PENDING)
  expiresAt        DateTime     @db.Timestamptz(3)
  acceptedByUserId String?      @db.Uuid
  acceptedAt       DateTime?    @db.Timestamptz(3)
  driverProfileId  String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedBy     User           @relation("InviteSender", fields: [invitedByUserId], references: [id])
  acceptedBy    User?          @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  driverProfile DriverProfile? @relation("InviteDriverProfile", fields: [driverProfileId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
}

model CompanyDocument {
  id                    String              @id @default(uuid()) @db.Uuid
  companyId             String              @db.Uuid
  uploadedByUserId      String              @db.Uuid
  verificationRequestId String?             @db.Uuid
  type                  CompanyDocumentType
  filename              String
  mimeType              String
  size                  Int
  storageKey            String
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?           @db.Timestamptz(3)

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id])

  uploadedBy User @relation("CompanyDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([companyId])
}

model VerificationRequest {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @db.Uuid
  submittedByUserId String                    @db.Uuid
  status            VerificationRequestStatus @default(PENDING)
  comment           String?
  reviewerUserId    String?                   @db.Uuid
  reviewComment     String?
  reviewedAt        DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents CompanyDocument[]

  submittedBy User  @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id])
  reviewer    User? @relation("VerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
}

// ───────────────────────────── Fleet ─────────────────────────────

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  plateNumber        String
  country            String
  make               String
  model              String
  year               Int?
  vehicleType        VehicleType
  bodyType           BodyType
  capacityKg         Decimal       @db.Decimal(12, 2)
  volumeM3           Decimal?      @db.Decimal(10, 2)
  vin                String?
  status             VehicleStatus @default(AVAILABLE)
  gpsEnabled         Boolean       @default(false)
  // ── Топливо и телематика ──
  engineType         String?
  fuelType           FuelType?
  tankCapacityLiters Decimal?      @db.Decimal(8, 1)
  /// Нормативный расход, л/100 км (задаёт владелец; архитектура допускает более сложную модель нормы)
  fuelNormPer100Km   Decimal?      @db.Decimal(5, 1)
  /// Провайдер телематики и идентификатор устройства у провайдера (null — не подключено)
  telematicsProvider String?
  telematicsDeviceId String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?     @db.Timestamptz(3)

  company            Company             @relation(fields: [companyId], references: [id])
  orders             TransportOrder[]
  plannedMovements   PlannedMovement[]
  fuelCards          FuelCard[]
  fuelTransactions   FuelTransaction[]
  telemetry          TelemetryReading[]
  fuelAnomalies      FuelAnomaly[]
  fuelInvestigations FuelInvestigation[]

  // Уникальность госномера — только среди неудалённых машин: частичный индекс "Vehicle_active_plate_unique" в миграции
  @@index([country, plateNumber])
  @@index([companyId, status])
  @@index([plateNumber])
}

model DriverProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String?      @db.Uuid
  companyId       String       @db.Uuid
  fullName        String
  phone           String
  licenseNumber   String
  licenseCategory String
  licenseExpiry   DateTime?    @db.Timestamptz(3)
  passportNumber  String?
  status          DriverStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)

  user             User?             @relation(fields: [userId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id])
  orders           TransportOrder[]
  plannedMovements PlannedMovement[]
  fuelCards        FuelCard[]
  fuelTransactions FuelTransaction[]

  invites            CompanyInvite[]     @relation("InviteDriverProfile")
  fuelAnomalies      FuelAnomaly[]       @relation("FuelAnomalyDriver")
  fuelInvestigations FuelInvestigation[] @relation("FuelInvestigationDriver")

  @@unique([companyId, userId])
  @@index([companyId, status])
}

// ───────────────────────────── Loads ─────────────────────────────

model Load {
  id                 String         @id @default(uuid()) @db.Uuid
  publicNumber       String         @unique
  companyId          String         @db.Uuid
  createdByUserId    String         @db.Uuid
  clientName         String?
  title              String
  cargoType          CargoType
  cargoDescription   String?
  weightKg           Decimal        @db.Decimal(12, 2)
  volumeM3           Decimal?       @db.Decimal(10, 2)
  packagesCount      Int?
  packageType        String?
  vehicleType        VehicleType?
  bodyType           BodyType?
  temperatureFrom    Decimal?       @db.Decimal(5, 1)
  temperatureTo      Decimal?       @db.Decimal(5, 1)
  requiresGps        Boolean        @default(false)
  requirements       String?
  priceType          PriceType
  targetPrice        Decimal?       @db.Decimal(14, 2)
  currency           Currency
  additionalTerms    String?
  loadingDateFrom    DateTime       @db.Timestamptz(3)
  loadingDateTo      DateTime?      @db.Timestamptz(3)
  deliveryDateFrom   DateTime?      @db.Timestamptz(3)
  deliveryDateTo     DateTime?      @db.Timestamptz(3)
  status             LoadStatus     @default(DRAFT)
  visibility         LoadVisibility @default(DRAFT)
  notes              String?
  // Денормализованные точки маршрута для быстрого поиска и индексов
  originCountry      String?
  originCity         String?
  destinationCountry String?
  destinationCity    String?
  publishedAt        DateTime?      @db.Timestamptz(3)
  cancelledAt        DateTime?      @db.Timestamptz(3)
  cancelReason       String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  createdBy   User             @relation("LoadCreatedBy", fields: [createdByUserId], references: [id])
  stops       LoadStop[]
  documents   LoadDocument[]
  bids        Bid[]
  invitations LoadInvitation[]
  questions   LoadQuestion[]
  order       TransportOrder?

  @@index([status])
  @@index([createdAt])
  @@index([loadingDateFrom])
  @@index([originCountry, originCity])
  @@index([destinationCountry, destinationCity])
  @@index([companyId, status])
}

model LoadStop {
  id              String    @id @default(uuid()) @db.Uuid
  loadId          String    @db.Uuid
  sequence        Int
  type            StopType
  country         String
  region          String?
  city            String
  street          String?
  building        String?
  postalCode      String?
  fullAddress     String?
  latitude        Float?
  longitude       Float?
  contactName     String?
  contactPhone    String?
  plannedDateFrom DateTime? @db.Timestamptz(3)
  plannedDateTo   DateTime? @db.Timestamptz(3)
  timezone        String?
  notes           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@unique([loadId, sequence])
}

model LoadInvitation {
  id               String   @id @default(uuid()) @db.Uuid
  loadId           String   @db.Uuid
  carrierCompanyId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrier Company @relation(fields: [carrierCompanyId], references: [id])

  @@unique([loadId, carrierCompanyId])
  @@index([carrierCompanyId])
}

model LoadDocument {
  id               String       @id @default(uuid()) @db.Uuid
  loadId           String       @db.Uuid
  uploadedByUserId String       @db.Uuid
  type             DocumentType
  filename         String
  mimeType         String
  size             Int
  storageKey       String
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?    @db.Timestamptz(3)

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  uploadedBy User @relation("LoadDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([loadId])
}

model LoadQuestion {
  id               String    @id @default(uuid()) @db.Uuid
  loadId           String    @db.Uuid
  companyId        String    @db.Uuid
  askedByUserId    String    @db.Uuid
  question         String
  answer           String?
  answeredByUserId String?   @db.Uuid
  answeredAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  askedBy    User  @relation("LoadQuestionAuthor", fields: [askedByUserId], references: [id])
  answeredBy User? @relation("LoadQuestionAnswerer", fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@index([loadId])
}

// ───────────────────────────── Bidding ─────────────────────────────

model Bid {
  id               String    @id @default(uuid()) @db.Uuid
  loadId           String    @db.Uuid
  carrierCompanyId String    @db.Uuid
  createdByUserId  String    @db.Uuid
  amount           Decimal   @db.Decimal(14, 2)
  currency         Currency
  comment          String?
  terms            String?
  readyDate        DateTime? @db.Timestamptz(3)
  status           BidStatus @default(PENDING)
  // Текущее встречное предложение заказчика (если есть) и чья очередь отвечать
  counterAmount    Decimal?  @db.Decimal(14, 2)
  awaitingSide     PartySide @default(CUSTOMER)
  validUntil       DateTime? @db.Timestamptz(3)
  decidedAt        DateTime? @db.Timestamptz(3)
  decidedByUserId  String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  load      Load            @relation(fields: [loadId], references: [id])
  carrier   Company         @relation(fields: [carrierCompanyId], references: [id])
  createdBy User            @relation("BidCreatedBy", fields: [createdByUserId], references: [id])
  messages  BidMessage[]
  order     TransportOrder?

  decidedBy User? @relation("BidDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([loadId])
  @@index([carrierCompanyId, status])
}

model BidMessage {
  id              String         @id @default(uuid()) @db.Uuid
  bidId           String         @db.Uuid
  authorUserId    String         @db.Uuid
  authorCompanyId String         @db.Uuid
  side            PartySide
  type            BidMessageType
  amount          Decimal?       @db.Decimal(14, 2)
  currency        Currency?
  message         String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  bid     Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorUserId], references: [id])
  company Company @relation(fields: [authorCompanyId], references: [id])

  @@index([bidId, createdAt])
}

// ───────────────────────────── Orders ─────────────────────────────

model TransportOrder {
  id                   String       @id @default(uuid()) @db.Uuid
  publicNumber         String       @unique
  loadId               String       @unique @db.Uuid
  shipperCompanyId     String       @db.Uuid
  carrierCompanyId     String       @db.Uuid
  forwarderCompanyId   String?      @db.Uuid
  acceptedBidId        String       @unique @db.Uuid
  agreedAmount         Decimal      @db.Decimal(14, 2)
  currency             Currency
  currentStatus        OrderStatus
  previousStatus       OrderStatus?
  statusChangedAt      DateTime     @default(now()) @db.Timestamptz(3)
  loadingDate          DateTime?    @db.Timestamptz(3)
  deliveryDate         DateTime?    @db.Timestamptz(3)
  vehicleId            String?      @db.Uuid
  driverId             String?      @db.Uuid
  deliveredAt          DateTime?    @db.Timestamptz(3)
  // Период проверки после доставки: до этого момента заказчик подтверждает получение или открывает спор
  confirmationDueAt    DateTime?    @db.Timestamptz(3)
  receiptConfirmedAt   DateTime?    @db.Timestamptz(3)
  // true — получение подтверждено системой по истечении периода проверки (без спора)
  receiptAutoConfirmed Boolean      @default(false)
  closedAt             DateTime?    @db.Timestamptz(3)
  cancelledAt          DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  load             Load                          @relation(fields: [loadId], references: [id])
  shipper          Company                       @relation("OrderShipper", fields: [shipperCompanyId], references: [id])
  carrier          Company                       @relation("OrderCarrier", fields: [carrierCompanyId], references: [id])
  forwarder        Company?                      @relation("OrderForwarder", fields: [forwarderCompanyId], references: [id])
  acceptedBid      Bid                           @relation(fields: [acceptedBidId], references: [id])
  vehicle          Vehicle?                      @relation(fields: [vehicleId], references: [id])
  driver           DriverProfile?                @relation(fields: [driverId], references: [id])
  statusHistory    TransportOrderStatusHistory[]
  participants     TransportOrderParticipant[]
  contracts        Contract[]
  documents        OrderDocument[]
  trackingEvents   TrackingEvent[]
  chatThread       ChatThread?
  payments         PaymentRecord[]
  reviews          Review[]
  disputes         Dispute[]
  nextMovements    PlannedMovement[]
  fuelTransactions FuelTransaction[]

  fuelAnomalies FuelAnomaly[] @relation("FuelAnomalyOrder")

  @@index([currentStatus])
  @@index([currentStatus, confirmationDueAt])
  @@index([carrierCompanyId])
  @@index([shipperCompanyId])
  @@index([forwarderCompanyId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

model TransportOrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  actorUserId     String?      @db.Uuid
  actorType       ActorType
  source          ActionSource
  comment         String?
  trackingEventId String?      @db.Uuid
  documentIds     String[]     @default([])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  order TransportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorUser User? @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model TransportOrderParticipant {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @db.Uuid
  companyId String?         @db.Uuid
  userId    String?         @db.Uuid
  role      ParticipantRole
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  order   TransportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company?       @relation(fields: [companyId], references: [id])

  user User? @relation("OrderParticipantUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderId, role, companyId, userId])
  @@index([companyId])
  @@index([userId])
}

// ───────────────────────────── Contracts ─────────────────────────────

model ContractTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  version   Int
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  contracts Contract[]

  @@unique([code, version])
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @db.Uuid
  templateId      String         @db.Uuid
  version         Int
  documentNumber  String         @unique
  title           String
  contentSnapshot String
  dataSnapshot    Json
  pdfUrl          String?
  contentHash     String
  status          ContractStatus @default(PENDING_SIGNATURES)
  signedAt        DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  order      TransportOrder      @relation(fields: [orderId], references: [id])
  template   ContractTemplate    @relation(fields: [templateId], references: [id])
  signatures ContractSignature[]

  @@unique([orderId, version])
}

model ContractSignature {
  id              String          @id @default(uuid()) @db.Uuid
  contractId      String          @db.Uuid
  userId          String          @db.Uuid
  companyId       String          @db.Uuid
  side            PartySide
  method          SignatureMethod
  signedAt        DateTime        @db.Timestamptz(3)
  ipAddress       String?
  userAgent       String?
  documentHash    String
  signatureStatus SignatureStatus @default(SIGNED)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([contractId])
}

// ───────────────────────────── Documents ─────────────────────────────

model OrderDocument {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  uploadedByUserId  String         @db.Uuid
  uploadedCompanyId String?        @db.Uuid
  type              DocumentType
  filename          String
  mimeType          String
  size              Int
  storageKey        String
  version           Int            @default(1)
  groupId           String         @db.Uuid
  status            DocumentStatus @default(ACTIVE)
  note              String?
  deletedAt         DateTime?      @db.Timestamptz(3)
  deletedByUserId   String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  order        TransportOrder @relation(fields: [orderId], references: [id])
  chatMessages ChatMessage[]

  uploadedBy      User     @relation("OrderDocumentUploader", fields: [uploadedByUserId], references: [id])
  deletedBy       User?    @relation("OrderDocumentDeleter", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  uploadedCompany Company? @relation("OrderDocumentCompany", fields: [uploadedCompanyId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([groupId])
}

// ───────────────────────────── Tracking ─────────────────────────────

model TrackingEvent {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @db.Uuid
  userId     String?           @db.Uuid
  type       TrackingEventType
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  note       String?
  source     TrackingSource
  recordedAt DateTime          @default(now()) @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  order TransportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  user User? @relation("TrackingEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ───────────────────────────── Chat ─────────────────────────────

model ChatThread {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  order      TransportOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  readStates ChatReadState[]
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  threadId        String    @db.Uuid
  senderUserId    String    @db.Uuid
  senderCompanyId String?   @db.Uuid
  message         String
  attachmentId    String?   @db.Uuid
  readAt          DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  thread     ChatThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User           @relation(fields: [senderUserId], references: [id])
  attachment OrderDocument? @relation(fields: [attachmentId], references: [id])

  senderCompany Company? @relation("ChatMessageCompany", fields: [senderCompanyId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model ChatReadState {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @db.Uuid
  userId     String   @db.Uuid
  lastReadAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  link       String?
  readAt     DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Finance ─────────────────────────────

/// Запись о платеже по сделке.
/// Ручной учёт (PREPAYMENT/FINAL_PAYMENT/OTHER) — стороны фиксируют расчёты вне платформы.
/// Безопасная сделка (SECURE_DEAL) — сумма обеспечена у платёжного провайдера; CargoFlow хранит только
/// статус, условия и журнал операций. Данные банковских карт не хранятся.
model PaymentRecord {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @db.Uuid
  payerCompanyId        String        @db.Uuid
  payeeCompanyId        String        @db.Uuid
  amount                Decimal       @db.Decimal(14, 2)
  currency              Currency
  type                  PaymentType
  status                PaymentStatus @default(PLANNED)
  dueDate               DateTime?     @db.Timestamptz(3)
  paidAt                DateTime?     @db.Timestamptz(3)
  note                  String?
  createdByUserId       String?       @db.Uuid
  // ── Безопасная сделка ──
  /// Комиссия платформы (снимок правила на момент создания сделки)
  platformFee           Decimal       @default(0) @db.Decimal(14, 2)
  feePercent            Decimal?      @db.Decimal(5, 2)
  feeFixed              Decimal?      @db.Decimal(14, 2)
  /// Выплачено перевозчику (брутто, до удержания комиссии) и возвращено заказчику
  releasedAmount        Decimal       @default(0) @db.Decimal(14, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(14, 2)
  /// Удержанная комиссия по уже выполненным выплатам
  feeCollected          Decimal       @default(0) @db.Decimal(14, 2)
  provider              String?
  providerTransactionId String?
  authorizedAt          DateTime?     @db.Timestamptz(3)
  reservedAt            DateTime?     @db.Timestamptz(3)
  releaseRequestedAt    DateTime?     @db.Timestamptz(3)
  releasedAt            DateTime?     @db.Timestamptz(3)
  refundedAt            DateTime?     @db.Timestamptz(3)
  cancelledAt           DateTime?     @db.Timestamptz(3)
  failedAt              DateTime?     @db.Timestamptz(3)
  failureReason         String?
  disputeId             String?       @db.Uuid
  metadata              Json?
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  order         TransportOrder         @relation(fields: [orderId], references: [id])
  payer         Company                @relation("PaymentPayer", fields: [payerCompanyId], references: [id])
  payee         Company                @relation("PaymentPayee", fields: [payeeCompanyId], references: [id])
  dispute       Dispute?               @relation(fields: [disputeId], references: [id])
  transactions  PaymentTransaction[]
  statusHistory PaymentStatusHistory[]

  createdBy User? @relation("PaymentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([type, status])
}

/// Операция у платёжного провайдера. Одна операция в статусе PENDING на платёж (частичный уникальный индекс).
model PaymentTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  paymentId             String                   @db.Uuid
  kind                  PaymentTransactionKind
  status                PaymentTransactionStatus @default(PENDING)
  amount                Decimal                  @db.Decimal(14, 2)
  /// Комиссия платформы, удерживаемая из этой выплаты
  fee                   Decimal                  @default(0) @db.Decimal(14, 2)
  currency              Currency
  provider              String
  providerTransactionId String?
  /// Ключ идемпотентности, передаваемый провайдеру: повтор операции не приводит к повторному движению средств
  idempotencyKey        String                   @unique
  requestedByUserId     String?                  @db.Uuid
  reason                String?
  failureReason         String?
  completedAt           DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  payment PaymentRecord @relation(fields: [paymentId], references: [id])

  requestedBy   User?                  @relation("PaymentOperationRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  statusChanges PaymentStatusHistory[] @relation("PaymentStatusTransaction")

  @@index([paymentId, createdAt])
  @@index([provider, providerTransactionId])
}

model PaymentStatusHistory {
  id            String         @id @default(uuid()) @db.Uuid
  paymentId     String         @db.Uuid
  fromStatus    PaymentStatus?
  toStatus      PaymentStatus
  actorUserId   String?        @db.Uuid
  actorType     ActorType
  reason        String?
  transactionId String?        @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  payment PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  actorUser   User?               @relation("PaymentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  transaction PaymentTransaction? @relation("PaymentStatusTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
}

// ───────────────────────────── Next Load ─────────────────────────────

/// План дальнейшего движения транспорта после (или до окончания) текущего рейса.
/// Подходящие грузы (NextLoadMatch) вычисляются на лету — см. src/lib/next-load/matching.ts
model PlannedMovement {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  vehicleId           String?        @db.Uuid
  driverId            String?        @db.Uuid
  sourceOrderId       String?        @db.Uuid
  createdByUserId     String         @db.Uuid
  intent              MovementIntent
  // Точка, где транспорт будет свободен (текущая позиция или точка разгрузки)
  originLabel         String
  originCountry       String?
  originCity          String?
  originLat           Float
  originLng           Float
  /// Откуда взята позиция: TRACKING (последняя отметка водителя), ORDER_DELIVERY (адрес разгрузки), MANUAL
  originSource        String
  /// Допустимое отклонение от коридора движения, км
  allowedDeviationKm  Int            @default(250)
  /// Радиус поиска погрузки вокруг текущей точки, км
  maxPickupDistanceKm Int            @default(300)
  availableFrom       DateTime       @db.Timestamptz(3)
  availableUntil      DateTime       @db.Timestamptz(3)
  status              MovementStatus @default(ACTIVE)
  note                String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  company      Company                      @relation(fields: [companyId], references: [id])
  vehicle      Vehicle?                     @relation(fields: [vehicleId], references: [id])
  driver       DriverProfile?               @relation(fields: [driverId], references: [id])
  sourceOrder  TransportOrder?              @relation(fields: [sourceOrderId], references: [id])
  destinations PlannedMovementDestination[]

  createdBy User @relation("PlannedMovementCreator", fields: [createdByUserId], references: [id])

  @@index([companyId, status])
  @@index([vehicleId, status])
  @@index([sourceOrderId])
}

model PlannedMovementDestination {
  id         String   @id @default(uuid()) @db.Uuid
  movementId String   @db.Uuid
  sequence   Int
  label      String
  country    String?
  city       String?
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  movement PlannedMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([movementId, sequence])
}

// ───────────────────────────── Reviews & Disputes ─────────────────────────────

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  fromCompanyId String   @db.Uuid
  toCompanyId   String   @db.Uuid
  fromUserId    String   @db.Uuid
  rating        Int
  punctuality   Int?
  communication Int?
  documentation Int?
  comment       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  order       TransportOrder @relation(fields: [orderId], references: [id])
  fromCompany Company        @relation("ReviewFrom", fields: [fromCompanyId], references: [id])
  toCompany   Company        @relation("ReviewTo", fields: [toCompanyId], references: [id])

  fromUser User @relation("ReviewAuthor", fields: [fromUserId], references: [id])

  @@unique([orderId, fromCompanyId])
  @@index([toCompanyId])
}

model Dispute {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  openedByUserId    String        @db.Uuid
  openedByCompanyId String?       @db.Uuid
  reason            DisputeReason
  description       String
  status            DisputeStatus @default(OPEN)
  orderStatusBefore OrderStatus
  resolution        String?
  resolvedByUserId  String?       @db.Uuid
  resolvedAt        DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  order    TransportOrder   @relation(fields: [orderId], references: [id])
  comments DisputeComment[]
  payments PaymentRecord[]

  openedBy        User     @relation("DisputeOpener", fields: [openedByUserId], references: [id])
  openedByCompany Company? @relation("DisputeOpenerCompany", fields: [openedByCompanyId], references: [id], onDelete: SetNull)
  resolvedBy      User?    @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

model DisputeComment {
  id           String   @id @default(uuid()) @db.Uuid
  disputeId    String   @db.Uuid
  authorUserId String   @db.Uuid
  message      String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  author User @relation("DisputeCommentAuthor", fields: [authorUserId], references: [id])

  @@index([disputeId, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  companyId   String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  actor   User?    @relation(fields: [actorUserId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  key            String
  scope          String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
}

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ───────────────────────────── Fleet Fuel Control ─────────────────────────────
// CargoFlow не хранит данные банковских карт (номер, PIN, CVV). Для карт хранится только безопасный
// идентификатор провайдера (token/cardId) и последние 4 цифры для отображения.

/// Корпоративный топливный счёт компании (баланс у провайдера топливных карт отражается здесь как учёт).
model FuelAccount {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  name              String
  currency          Currency
  balance           Decimal  @default(0) @db.Decimal(14, 2)
  /// Зарезервировано авторизованными, но ещё не завершёнными заправками
  reserved          Decimal  @default(0) @db.Decimal(14, 2)
  provider          String
  providerAccountId String?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id])
  entries      FuelAccountEntry[]
  cards        FuelCard[]
  transactions FuelTransaction[]

  @@unique([companyId, currency])
}

/// Журнал движения по топливному счёту (только дополняется).
model FuelAccountEntry {
  id                String               @id @default(uuid()) @db.Uuid
  accountId         String               @db.Uuid
  type              FuelAccountEntryType
  /// Сумма операции (положительная); направление определяется типом
  amount            Decimal              @db.Decimal(14, 2)
  balanceAfter      Decimal              @db.Decimal(14, 2)
  reservedAfter     Decimal              @db.Decimal(14, 2)
  fuelTransactionId String?              @db.Uuid
  externalReference String?
  note              String?
  createdByUserId   String?              @db.Uuid
  idempotencyKey    String               @unique
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  account FuelAccount @relation(fields: [accountId], references: [id])

  createdBy       User?            @relation("FuelEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fuelTransaction FuelTransaction? @relation("FuelEntryTransaction", fields: [fuelTransactionId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}

model FuelCard {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  fuelAccountId         String         @db.Uuid
  vehicleId             String?        @db.Uuid
  driverId              String?        @db.Uuid
  /// Внутренний номер карты в компании (например, FC-001)
  label                 String
  provider              String
  /// Безопасный идентификатор карты у провайдера (token). Не номер карты.
  providerCardId        String
  /// Только последние 4 цифры для отображения
  last4                 String?
  status                FuelCardStatus @default(ACTIVE)
  expiresAt             DateTime?      @db.Timestamptz(3)
  // ── Лимиты (проверяются на сервере при каждой авторизации) ──
  perTransactionLiters  Decimal?       @db.Decimal(8, 1)
  dailyLiters           Decimal?       @db.Decimal(8, 1)
  monthlyLiters         Decimal?       @db.Decimal(10, 1)
  dailyAmount           Decimal?       @db.Decimal(14, 2)
  monthlyAmount         Decimal?       @db.Decimal(14, 2)
  allowedFuelTypes      FuelType[]     @default([])
  /// Разрешённые сети АЗС (пусто — любые)
  allowedStationBrands  String[]       @default([])
  /// Разрешённые конкретные АЗС (id у провайдера; пусто — любые)
  allowedStationIds     String[]       @default([])
  /// Разрешённые страны/регионы (ISO-код страны, например KZ; пусто — любые)
  allowedRegions        String[]       @default([])
  /// Разрешённое время, минуты от полуночи в часовом поясе карты (null — круглосуточно)
  allowedFromMinute     Int?
  allowedToMinute       Int?
  timezone              String         @default("Asia/Almaty")
  /// Показывать водителю текущий уровень топлива
  driverCanSeeFuelLevel Boolean        @default(true)
  blockedReason         String?
  isDemo                Boolean        @default(false)
  createdByUserId       String         @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  company      Company           @relation(fields: [companyId], references: [id])
  account      FuelAccount       @relation(fields: [fuelAccountId], references: [id])
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id])
  driver       DriverProfile?    @relation(fields: [driverId], references: [id])
  transactions FuelTransaction[]

  createdBy User @relation("FuelCardCreator", fields: [createdByUserId], references: [id])

  @@unique([provider, providerCardId])
  @@unique([companyId, label])
  @@index([companyId, status])
  @@index([driverId])
  @@index([vehicleId])
}

model FuelTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @db.Uuid
  fuelAccountId         String                @db.Uuid
  fuelCardId            String                @db.Uuid
  vehicleId             String?               @db.Uuid
  driverId              String?               @db.Uuid
  orderId               String?               @db.Uuid
  provider              String
  providerTransactionId String
  stationId             String?
  stationName           String
  stationBrand          String?
  stationAddress        String?
  stationCountry        String?
  latitude              Float?
  longitude             Float?
  fuelType              FuelType
  liters                Decimal               @db.Decimal(8, 2)
  pricePerLiter         Decimal               @db.Decimal(12, 2)
  totalAmount           Decimal               @db.Decimal(14, 2)
  /// Сумма, зарезервированная при авторизации
  authorizedAmount      Decimal               @default(0) @db.Decimal(14, 2)
  currency              Currency
  transactionDate       DateTime              @db.Timestamptz(3)
  status                FuelTransactionStatus @default(PENDING)
  source                FuelTransactionSource
  declineReason         String?
  // ── Сопоставление с телематикой ──
  matchStatus           FuelMatchStatus       @default(PENDING)
  anomalyScore          Int                   @default(0)
  levelBefore           Float?
  levelAfter            Float?
  levelSource           FuelLevelSource?
  gpsDistanceKm         Float?
  analyzedAt            DateTime?             @db.Timestamptz(3)
  analysis              Json?
  isDemo                Boolean               @default(false)
  metadata              Json?
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  company        Company                        @relation(fields: [companyId], references: [id])
  account        FuelAccount                    @relation(fields: [fuelAccountId], references: [id])
  card           FuelCard                       @relation(fields: [fuelCardId], references: [id])
  vehicle        Vehicle?                       @relation(fields: [vehicleId], references: [id])
  driver         DriverProfile?                 @relation(fields: [driverId], references: [id])
  order          TransportOrder?                @relation(fields: [orderId], references: [id])
  anomalies      FuelAnomaly[]
  investigations FuelInvestigationTransaction[]

  accountEntries FuelAccountEntry[] @relation("FuelEntryTransaction")

  @@unique([provider, providerTransactionId])
  @@index([companyId, transactionDate])
  @@index([vehicleId, transactionDate])
  @@index([driverId, transactionDate])
  @@index([fuelCardId, transactionDate])
  @@index([orderId])
}

/// Показания телематики/датчиков. null в поле = параметр недоступен (NOT_AVAILABLE), значения не выдумываются.
model TelemetryReading {
  id              String           @id @default(uuid()) @db.Uuid
  vehicleId       String           @db.Uuid
  source          TelemetrySource
  provider        String
  recordedAt      DateTime         @db.Timestamptz(3)
  latitude        Float?
  longitude       Float?
  speedKmh        Float?
  heading         Float?
  engineOn        Boolean?
  odometerKm      Float?
  fuelLevelLiters Float?
  /// Обязателен, если указан уровень топлива
  fuelLevelSource FuelLevelSource?
  /// Накопительный счётчик израсходованного топлива (CAN), л
  fuelUsedTotalL  Float?
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, source, recordedAt])
  @@index([vehicleId, recordedAt])
}

model FuelAnomaly {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  vehicleId         String              @db.Uuid
  driverId          String?             @db.Uuid
  fuelTransactionId String?             @db.Uuid
  orderId           String?             @db.Uuid
  investigationId   String?             @db.Uuid
  type              FuelAnomalyType
  severity          FuelAnomalySeverity
  score             Int
  /// Нейтральное объяснение («зарегистрирована заправка 300 л, увеличение уровня — 48 л»)
  explanation       String
  details           Json
  status            FuelAnomalyStatus   @default(OPEN)
  /// Ключ для идемпотентного повторного анализа
  dedupeKey         String              @unique
  detectedAt        DateTime            @default(now()) @db.Timestamptz(3)
  reviewedByUserId  String?             @db.Uuid
  reviewedAt        DateTime?           @db.Timestamptz(3)
  reviewComment     String?
  isDemo            Boolean             @default(false)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  company       Company            @relation(fields: [companyId], references: [id])
  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id])
  transaction   FuelTransaction?   @relation(fields: [fuelTransactionId], references: [id])
  investigation FuelInvestigation? @relation(fields: [investigationId], references: [id])

  driver     DriverProfile?  @relation("FuelAnomalyDriver", fields: [driverId], references: [id], onDelete: SetNull)
  order      TransportOrder? @relation("FuelAnomalyOrder", fields: [orderId], references: [id], onDelete: SetNull)
  reviewedBy User?           @relation("FuelAnomalyReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, detectedAt])
  @@index([vehicleId, detectedAt])
}

model FuelInvestigation {
  id             String                  @id @default(uuid()) @db.Uuid
  companyId      String                  @db.Uuid
  vehicleId      String                  @db.Uuid
  driverId       String?                 @db.Uuid
  title          String
  status         FuelInvestigationStatus @default(OPEN)
  openedByUserId String                  @db.Uuid
  resolution     String?
  closedByUserId String?                 @db.Uuid
  closedAt       DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  company      Company                        @relation(fields: [companyId], references: [id])
  vehicle      Vehicle                        @relation(fields: [vehicleId], references: [id])
  anomalies    FuelAnomaly[]
  transactions FuelInvestigationTransaction[]
  comments     FuelInvestigationComment[]
  attachments  FuelInvestigationAttachment[]

  driver   DriverProfile? @relation("FuelInvestigationDriver", fields: [driverId], references: [id], onDelete: SetNull)
  openedBy User           @relation("FuelInvestigationOpener", fields: [openedByUserId], references: [id])
  closedBy User?          @relation("FuelInvestigationCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

model FuelInvestigationTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  investigationId   String   @db.Uuid
  fuelTransactionId String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  investigation FuelInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  transaction   FuelTransaction   @relation(fields: [fuelTransactionId], references: [id])

  @@unique([investigationId, fuelTransactionId])
}

model FuelInvestigationComment {
  id              String   @id @default(uuid()) @db.Uuid
  investigationId String   @db.Uuid
  authorUserId    String   @db.Uuid
  message         String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  investigation FuelInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  author User @relation("FuelInvestigationCommentAuthor", fields: [authorUserId], references: [id])

  @@index([investigationId, createdAt])
}

model FuelInvestigationAttachment {
  id               String    @id @default(uuid()) @db.Uuid
  investigationId  String    @db.Uuid
  uploadedByUserId String    @db.Uuid
  filename         String
  mimeType         String
  size             Int
  storageKey       String
  note             String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  investigation FuelInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  uploadedBy User @relation("FuelInvestigationAttachmentUploader", fields: [uploadedByUserId], references: [id])

  @@index([investigationId])
}
