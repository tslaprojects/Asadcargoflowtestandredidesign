enum PaymentType {
  PREPAYMENT
  FINAL_PAYMENT
  OTHER
  // Безопасная сделка: оплата обеспечена у платёжного провайдера и выплачивается по условиям сделки
  SECURE_DEAL
}

// PLANNED / INVOICED / PAID / CANCELLED — ручной учёт расчётов (PREPAYMENT, FINAL_PAYMENT, OTHER).
// PAYMENT_* — состояния безопасной сделки (SECURE_DEAL), см. src/lib/state-machine/payment-state-machine.ts
enum PaymentStatus {
  PLANNED
  INVOICED
  PAID
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_RESERVED
  PAYMENT_RELEASE_PENDING
  PAYMENT_RELEASED
  PAYMENT_PARTIALLY_RELEASED
  PAYMENT_REFUNDED
  PAYMENT_DISPUTED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
}

/// Операция у платёжного провайдера (движение средств выполняет провайдер, не CargoFlow).
enum PaymentTransactionKind {
  AUTHORIZE
  RESERVE
  RELEASE
  REFUND
  VOID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Что перевозчик планирует после доставки.
enum MovementIntent {
  RETURN
  CITY
  DIRECTION
  UNDECIDED
}

enum MovementStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

enum DisputeReason {
  NOT_DELIVERED
  DELAY
  DAMAGE
  SHORTAGE
  TERMS_VIOLATION
  MISSING_DOCUMENTS
  CARGO_MISMATCH
  PAYMENT_ISSUE
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ───────────────────────────── Fuel Control: enums ─────────────────────────────

enum FuelType {
  DIESEL
  PETROL
  LNG
  CNG
  LPG
  ADBLUE
  OTHER
}

enum FuelCardStatus {
  ACTIVE
