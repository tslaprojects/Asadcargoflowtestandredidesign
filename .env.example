# ───────── Database ─────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargoflow?schema=public"
# Демо-база (режим «🧪 Демо-база» на странице входа). Пусто — та же СУБД, отдельная схема cargoflow_demo.
# Можно указать отдельную базу. Обязана отличаться от DATABASE_URL (иначе приложение и seed:demo остановятся).
# Схемы создаёт и помечает `npm run db:migrate:all`; демо-данные — `npm run seed:demo` / `npm run seed:demo:reset`.
DEMO_DATABASE_URL=""
# Отдельная БД для интеграционных и E2E тестов (будет очищаться!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargoflow_test?schema=public"

# ───────── App ─────────
APP_URL="http://localhost:3000"
# Зарезервировано для будущих подписанных ссылок (сейчас приложением не используется). Сгенерируйте: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Время жизни сессии (дни)
SESSION_TTL_DAYS="14"
# Сколько доверенных прокси стоит перед приложением (для IP клиента из X-Forwarded-For и rate limit). 0 — не доверять XFF.
TRUSTED_PROXY_HOPS="1"

# ───────── File storage ─────────
# local — файлы в ./storage (для разработки); s3 — любое S3-совместимое хранилище (MinIO, AWS S3, Yandex Object Storage…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cargoflow"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_MB="15"

# ───────── Notifications ─────────
# log — письма пишутся в лог сервера (разработка); smtp — в будущем через адаптер
EMAIL_DRIVER="log"
EMAIL_FROM="CargoFlow <no-reply@cargoflow.local>"
# Необязательные адаптеры (не требуются для локального запуска)
TELEGRAM_BOT_TOKEN=""
WHATSAPP_API_TOKEN=""

# ───────── Maps ─────────
# URL стиля MapLibre. Пусто — используется встроенный растровый стиль OpenStreetMap.
NEXT_PUBLIC_MAP_STYLE_URL=""

# ───────── Logging ─────────
LOG_LEVEL="info"

# ───────── Secure Deal / платёжный провайдер ─────────
# CargoFlow не хранит деньги: резерв, выплата и возврат выполняет платёжный провайдер.
# sandbox — тестовый режим (операции «успешны» сразу, реальные деньги не движутся; по умолчанию вне production).
#           В production запрещён, кроме демо-стенда (DEMO_SEED=1) или явного ALLOW_SANDBOX_PAYMENTS=1.
# manual  — провайдер не подключён: каждую операцию подтверждает администратор по данным банка-партнёра (по умолчанию в production)
# Пусто — sandbox в разработке, manual в production.
PAYMENT_PROVIDER=""
# Секрет подписи webhook провайдера (HMAC-SHA256 тела в заголовке X-CargoFlow-Signature). Пусто — webhook отключён.
PAYMENT_WEBHOOK_SECRET=""
# Ключ для плановой задачи POST /api/system/jobs/secure-deal (внешний cron). Пусто — внешний вызов отключён.
CRON_SECRET=""
# Встроенный планировщик задачи безопасной сделки, минуты (по умолчанию 10 в production, 0 — выключен).
JOB_SECURE_DEAL_INTERVAL_MIN=""
# Разрешить sandbox-провайдер в production (только для стендов без реальных денег)
ALLOW_SANDBOX_PAYMENTS=""

# ───────── Fleet Fuel Control ─────────
# CargoFlow не хранит данные банковских/топливных карт (номер, PIN, CVV): только токен провайдера и последние 4 цифры.
# demo — симулятор топливных карт и АЗС (все операции помечаются DEMO DATA). Реальные провайдеры подключаются адаптером FuelCardProvider.
FUEL_CARD_PROVIDER="demo"
# Секрет подписи webhook провайдера топливных карт (HMAC-SHA256 тела в X-CargoFlow-Signature). Пусто — webhook отключён.
FUEL_CARD_WEBHOOK_SECRET=""
# Секрет подписи входящих данных телематики (CAN/датчик уровня/GPS). Пусто — приём отключён.
TELEMATICS_WEBHOOK_SECRET=""

# ───────── Демо-стенд ─────────
# 1 — при старте контейнера загрузить демо-базу (seed:demo), если она пуста. Пишет только в демо-базу
# (DEMO_DATABASE_URL / схема cargoflow_demo с меткой cargoflow:demo); реальная база не затрагивается.
DEMO_SEED=""
# Детерминированный генератор демо-мира: ключ (одинаковый ключ — одинаковые данные) и «текущая» дата (ISO).
# Пусто — ключ "cargoflow-demo", даты относительно момента загрузки.
DEMO_SEED_KEY=""
DEMO_SEED_DATE=""
# Пароль демо-администратора в production (не короче 12 символов). Не задан — случайный, нигде не выводится.
DEMO_ADMIN_PASSWORD=""
# 1 — разрешить регистрацию на демо-стенде (по умолчанию при DEMO_SEED=1 в production закрыта)
ALLOW_PUBLIC_REGISTRATION=""
# 1 — показывать на странице входа кнопки демо-аккаунтов в production (встраивается при сборке).
NEXT_PUBLIC_SHOW_DEMO=""
