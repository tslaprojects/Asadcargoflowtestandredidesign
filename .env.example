# ───────── Database ─────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargoflow?schema=public"
# Отдельная БД для интеграционных и E2E тестов (будет очищаться!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargoflow_test?schema=public"

# ───────── App ─────────
APP_URL="http://localhost:3000"
# Секрет для подписи ссылок на файлы и прочих HMAC. Сгенерируйте: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Время жизни сессии (дни)
SESSION_TTL_DAYS="14"

# ───────── File storage ─────────
# local — файлы в ./storage (для разработки); s3 — любое S3-совместимое хранилище (MinIO, AWS S3, Yandex Object Storage…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cargoflow"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_MB="15"

# ───────── Notifications ─────────
# log — письма пишутся в лог сервера (разработка); smtp — в будущем через адаптер
EMAIL_DRIVER="log"
EMAIL_FROM="CargoFlow <no-reply@cargoflow.local>"
# Необязательные адаптеры (не требуются для локального запуска)
TELEGRAM_BOT_TOKEN=""
WHATSAPP_API_TOKEN=""

# ───────── Maps ─────────
# URL стиля MapLibre. Пусто — используется встроенный растровый стиль OpenStreetMap.
NEXT_PUBLIC_MAP_STYLE_URL=""

# ───────── Logging ─────────
LOG_LEVEL="info"

# ───────── Secure Deal / платёжный провайдер ─────────
# CargoFlow не хранит деньги: резерв, выплата и возврат выполняет платёжный провайдер.
# sandbox — тестовый режим (операции «успешны» сразу, реальные деньги не движутся; по умолчанию вне production)
# manual  — провайдер не подключён: каждую операцию подтверждает администратор по данным банка-партнёра (по умолчанию в production)
PAYMENT_PROVIDER="sandbox"
# Секрет подписи webhook провайдера (HMAC-SHA256 тела в заголовке X-CargoFlow-Signature). Пусто — webhook отключён.
PAYMENT_WEBHOOK_SECRET=""
# Ключ для плановой задачи POST /api/system/jobs/secure-deal (автоподтверждение по истечении срока проверки). Пусто — отключено.
CRON_SECRET=""
